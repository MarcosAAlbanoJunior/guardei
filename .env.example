# Copie para .env e preencha (veja o passo a passo no README).

# Obrigatório. Token que o @BotFather entrega ao criar o bot.
TELEGRAM_BOT_TOKEN=

# Obrigatório. Seu ID numérico no Telegram (pergunte ao @userinfobot).
# Vários usuários: separe por vírgula, ex.: 111111111,222222222
ALLOWED_USER_IDS=

# Opcional. Chave do Google AI Studio. Vazio = modo manual, sem IA.
GEMINI_API_KEY=

# Opcional (valores padrão abaixo):
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# MAX_VIDEO_SECONDS=600
# SEARCH_LIMIT=5
# YTDLP_PATH=yt-dlp
# DB_PATH=./data/app.db
